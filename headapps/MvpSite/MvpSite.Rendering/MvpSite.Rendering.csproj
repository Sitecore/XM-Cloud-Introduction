<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>MvpSite.Rendering</RootNamespace>
	</PropertyGroup>

	<!-- BuildWebCompiler2022 shells out to cmd.exe, so only run the SCSS compilation on Windows -->
	<PropertyGroup Condition="'$(RunWebCompiler)' == '' And !$([MSBuild]::IsOSPlatform('Windows'))">
		<RunWebCompiler>False</RunWebCompiler>
	</PropertyGroup>

	<ItemGroup>
	  <Content Remove="compilerconfig.json" />
	  <Content Remove="wwwroot\sass\**\*.scss" />
	</ItemGroup> 

	<ItemGroup>
	  <None Include="compilerconfig.json" />
	  <None Include="wwwroot\sass\**\*.scss" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="BuildWebCompiler2022" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
		<PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
		<PackageReference Include="Sitecore.AspNetCore.SDK.LayoutService.Client" />
		<PackageReference Include="Sitecore.AspNetCore.SDK.RenderingEngine" />
		<PackageReference Include="Sitecore.AspNetCore.SDK.Pages" />
		<PackageReference Include="System.ServiceModel.Syndication" />
		<PackageReference Include="Markdig" />
		<PackageReference Include="Mvp.Selections.Client" />
		<PackageReference Include="Okta.AspNetCore" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
	</ItemGroup>

</Project>